DEBIAN_CONTROL = ${TOP_DIR}/debian/DEBIAN/control
DEBIAN_SRIOV_CONTROL = ${TOP_DIR}/debian-sriov/DEBIAN/control
BUILD_VER_ENV = ${DEBIAN_VERSION}~$(UBUNTU_VERSION_NUMBER)
GPUAGENT_LIBS := ${ASSETS_PATH}/amd_smi_lib/x86_64/${UBUNTU_LIBDIR}/lib
GPUAGENT_LIBS_RHEL9 := ${ASSETS_PATH}/amd_smi_lib/x86_64/RHEL9/lib
GPUAGENT_SRIOV_LIBS := ${ASSETS_PATH}/gim_smi_lib/x86_64/${UBUNTU_LIBDIR}/lib
GPUAGENT_SRIOV_LIBS_RHEL9 := ${ASSETS_PATH}/gim_smi_lib/x86_64/RHEL9/lib
PROFILER_DEB_LIBS := ${TOP_DIR}/build/assets/${UBUNTU_LIBDIR}/profilerlibs/
PROFILER_RPM_LIBS_RHEL9 := ${TOP_DIR}/build/assets/RHEL9/profilerlibs/
ROCPROFILER_ASSETS := ${ASSETS_PATH}/rocprofiler
PKG_PATH := ${TOP_DIR}/debian/usr/local/bin
PKG_SRIOV_PATH := ${TOP_DIR}/debian-sriov/usr/local/bin
RPM_PATH := ${TOP_DIR}/SOURCES/
PKG_LIB_PATH := ${TOP_DIR}/debian/usr/local/metrics
PKG_SRIOV_LOCAL_PATH := ${TOP_DIR}/debian-sriov/usr/local
PKG_SRIOV_LIB_PATH := ${TOP_DIR}/debian-sriov/usr/local/metrics
ROCPROFLER_SDK_ASSETS :=  ${ASSETS_PATH}/rocprofiler-sdk
SDK_COUNTER_DEF := ${TOP_DIR}/debian/usr/local/metrics/share/rocprofiler-sdk
LUA_PROTO := ${TOP_DIR}/pkg/amdgpu/proto/luaplugin.proto
LIB_CONF_PATH := ${TOP_DIR}/debian/usr/local/etc/metrics/gpuagent.conf
PKG_LUA_PATH := ${TOP_DIR}/debian/usr/local/etc/metrics/slurm
PKG_SRIOV_LUA_PATH := ${TOP_DIR}/debian-sriov/usr/local/etc/metrics/slurm
METRICS_CONF_DIR := ${TOP_DIR}/debian/etc
METRICS_SRIOV_CONF_DIR := ${TOP_DIR}/debian-sriov/etc
METRICS_CONF_PATH := ${METRICS_CONF_DIR}/metrics
METRICS_SRIOV_CONF_PATH := ${METRICS_SRIOV_CONF_DIR}/metrics
BUILT_LIB_PATH := ${TOP_DIR}/build/assets/${UBUNTU_LIBDIR}/exporterout/
BUILT_LIB_RHEL9_PATH := ${TOP_DIR}/build/assets/RHEL9/exporterout/lib
RPM_DIR_NAME := amdgpu-exporter-$(RPM_BUILD_VERSION)-$(RPM_RELEASE_LABEL)
RPM_SRIOV_DIR_NAME := amdgpu-exporter-sriov-$(RPM_BUILD_VERSION)-$(RPM_RELEASE_LABEL)
RPM_UAL_DIR_NAME := amdgpuifoe-exporter-$(RPM_BUILD_VERSION)-$(RPM_RELEASE_LABEL)
RPM_PACKAGE_DIR := ${TOP_DIR}/${RPM_DIR_NAME}
RPM_PACKAGE_SRIOV_DIR := ${TOP_DIR}/${RPM_SRIOV_DIR_NAME}
RPM_PACKAGE_UAL_DIR := ${TOP_DIR}/${RPM_UAL_DIR_NAME}

# NIC debian build related variables
NIC_DEBIAN_CONTROL = ${TOP_DIR}/nic-debian/DEBIAN/control
NIC_PKG_PATH := ${TOP_DIR}/nic-debian/usr/local/bin
NIC_METRICS_CONF_DIR := ${TOP_DIR}/nic-debian/etc
NIC_METRICS_CONF_PATH := ${NIC_METRICS_CONF_DIR}/metrics

.PHONY: debpkg debpkg-ual debpkg-clean rpmpkg rpmpkg-clean rpmpkg-ual rpmpkg-ual-clean pkg pkg-clean debpkg-sriov-clean debpkg-sriov rpmpkg-sriov nic-debpkg
pkg: debpkg rpmpkg nic-debpkg

pkg-clean: debpkg-clean debpkg-sriov-clean rpmpkg-clean rpmpkg-ual-clean

rpmpkg-clean:
	echo "clean rpm package"
	@rm -rf ${RPM_PACKAGE_DIR}
	@rm -rf ${RPM_PACKAGE_SRIOV_DIR}
	@rm -rf ${RPM_PACKAGE_UAL_DIR}
	@rm -rf ${${PKG_SRIOV_LUA_PATH}}
	@rm -rf *.tar.gz
	@rm -rf ${RPM_PATH}/*.tar.gz
	@rm -rf ${TOP_DIR}/BUILD
	@rm -rf ${TOP_DIR}/RPMS
	@rm -rf ${TOP_DIR}/SRPMS
	@rm -rf ${TOP_DIR}/BUILDROOT
	@rm -rf ${TOP_DIR}/SOURCES

define rpmpkg-stage-common
	@mkdir -p $(RPM_STAGE_DIR)/bin $(RPM_STAGE_DIR)/lib $(RPM_STAGE_DIR)/share/rocprofiler-sdk
	tar -xf $(RPM_GPUAGENT_BIN) -C $(RPM_STAGE_DIR)/bin/
	@cp -vf $(RPM_GPUCTL_BIN) $(RPM_STAGE_DIR)/bin/gpuctl
	@cp -vf $(CURDIR)/bin/amd-metrics-exporter $(RPM_STAGE_DIR)/bin/
	@cp -vf $(CURDIR)/bin/metricsclient $(RPM_STAGE_DIR)/bin/
	@cp -vf $(CURDIR)/bin/amdgpuhealth $(RPM_STAGE_DIR)/bin/
	@cp -vaf ${TOP_DIR}/tools/techsupport/metrics-exporter-ts.sh $(RPM_STAGE_DIR)/bin/metrics-exporter-ts.sh
	@cp -rvf ${GPUAGENT_LIBS_RHEL9}/ $(RPM_STAGE_DIR)/
	@if [ ! -d $(PROFILER_RPM_LIBS_RHEL9) ]; then \
		echo "profiler dependent assets not built, run target libcopy-assets-RHEL9"; \
		exit 1; \
	fi
	@cp -vaf $(PROFILER_RPM_LIBS_RHEL9)/rocprofilerdeplib/lib* $(RPM_STAGE_DIR)/lib/
	@cp -vf ${ROCPROFILER_ASSETS}/librocpclient* $(RPM_STAGE_DIR)/lib/
	@cp -vf ${ROCPROFILER_ASSETS}/rocpctl $(RPM_STAGE_DIR)/bin/
	@cp -vf ${ROCPROFLER_SDK_ASSETS}/* $(RPM_STAGE_DIR)/share/rocprofiler-sdk
	@jq '$(RPM_JQ_FILTER)' $(CONFIG_DIR)/config.json > $(RPM_STAGE_DIR)/bin/config.json
	@cp -vaf ${TOP_DIR}/debian $(RPM_STAGE_DIR)/
	@cp -vf ${LUA_PROTO} $(RPM_STAGE_DIR)/debian/usr/local/etc/metrics/slurm/plugin.proto
endef

define rpmpkg-finalize
	@cp -vaf LICENSE $(RPM_STAGE_DIR)/
	@cp -vaf README.md $(RPM_STAGE_DIR)/
	@rm -rf ${RPM_PATH}
	@mkdir -p ${RPM_PATH}
	@tar czvf $(RPM_DIR_LABEL).tar.gz $(RPM_DIR_LABEL)
	@mv -vf $(RPM_DIR_LABEL).tar.gz ${RPM_PATH}/
	@sed -i "s/RPM_BUILD_VERSION/$(RPM_BUILD_VERSION)/g" rpmbuild/amdgpu-exporter.spec
	@sed -i "s/RPM_RELEASE_LABEL/$(RPM_RELEASE_LABEL)/g" rpmbuild/amdgpu-exporter.spec
	@rpmbuild -ba --define "_topdir `pwd`" $(RPM_BUILD_DEFINES) -v --buildroot `pwd`/BUILDROOT/ \
		--undefine dist rpmbuild/amdgpu-exporter.spec
	@git checkout rpmbuild/amdgpu-exporter.spec
	@mv -v ${TOP_DIR}/RPMS/x86_64/$(RPM_OUTPUT_GLOB) ${TOP_DIR}/bin/$(RPM_OUTPUT_FILE)
endef

rpmpkg: RPM_STAGE_DIR    = ${RPM_PACKAGE_DIR}
rpmpkg: RPM_GPUAGENT_BIN = ${ASSETS_PATH}/gpuagent_static.bin.gz
rpmpkg: RPM_GPUCTL_BIN   = ${ASSETS_PATH}/gpuctl.gobin
rpmpkg: RPM_JQ_FILTER    = .CommonConfig.HealthService.Enable = false | del(.GPUConfig.ExtraPodLabels, .NICConfig, .IFOEConfig)
rpmpkg: RPM_DIR_LABEL    = ${RPM_DIR_NAME}
rpmpkg: RPM_BUILD_DEFINES =
rpmpkg: RPM_OUTPUT_GLOB  = amdgpu-exporter*.x86_64.rpm
rpmpkg: RPM_OUTPUT_FILE  = amdgpu-exporter-rhel9.x86_64.rpm
rpmpkg: rpmpkg-clean
	@echo "build rpm package for $(RPM_BUILD_VERSION)-$(RPM_RELEASE_LABEL)"
	${MAKE} amdexporter
	$(rpmpkg-stage-common)
	$(rpmpkg-finalize)

rpmpkg-sriov: rpmpkg-clean
	@echo "build rpm sriov package for $(RPM_BUILD_VERSION)-$(RPM_RELEASE_LABEL)"
	${MAKE} amdexporter
	# copy to bin folders for tar
	@mkdir -p ${RPM_PACKAGE_SRIOV_DIR}/bin
	@mkdir -p ${RPM_PACKAGE_SRIOV_DIR}/lib
	@mkdir -p ${PKG_SRIOV_LUA_PATH}
	tar -xf ${ASSETS_PATH}/gpuagent_sriov_static.bin.gz -C ${RPM_PACKAGE_SRIOV_DIR}/bin/
	@mv -vf ${RPM_PACKAGE_SRIOV_DIR}/bin/gpuagent ${RPM_PACKAGE_SRIOV_DIR}/bin/gpuagent-sriov
	@cp -vaf ${TOP_DIR}/tools/techsupport/metrics-exporter-ts.sh ${RPM_PACKAGE_SRIOV_DIR}/bin/metrics-exporter-ts.sh
	@cp -vf ${ASSETS_PATH}/gpuctl.gobin ${RPM_PACKAGE_SRIOV_DIR}/bin/gpuctl
	@cp -vf $(CURDIR)/bin/amd-metrics-exporter ${RPM_PACKAGE_SRIOV_DIR}/bin/amd-metrics-exporter-sriov
	@cp -vf $(CURDIR)/bin/metricsclient ${RPM_PACKAGE_SRIOV_DIR}/bin/
	@cp -vf $(CURDIR)/bin/amdgpuhealth ${RPM_PACKAGE_SRIOV_DIR}/bin/
	@cp -rvf  ${PKG_LUA_PATH}/ ${PKG_SRIOV_LUA_PATH}/../
	@cp -vf ${LIB_CONF_PATH} ${PKG_SRIOV_LUA_PATH}/../
	@cp -vf ${LUA_PROTO} ${PKG_SRIOV_LUA_PATH}/plugin.proto
	# copy libraries
	@echo "Copy prebuilt libraries"
	@cp -rvf ${GPUAGENT_SRIOV_LIBS_RHEL9}/ ${RPM_PACKAGE_SRIOV_DIR}/
	#copy default config
	@jq '.CommonConfig.HealthService.Enable = false | del(.GPUConfig.ExtraPodLabels, .NICConfig, .IFOEConfig)' $(CONFIG_DIR)/config.json > ${RPM_PACKAGE_SRIOV_DIR}/bin/config.json
	@cat ${RPM_PACKAGE_SRIOV_DIR}/bin/config.json
	@cp -vaf ${TOP_DIR}/debian-sriov ${RPM_PACKAGE_SRIOV_DIR}/
	@cp -vaf LICENSE ${RPM_PACKAGE_SRIOV_DIR}/
	@cp -vaf README.md ${RPM_PACKAGE_SRIOV_DIR}/
	@rm -rf ${RPM_PATH}
	@mkdir -p ${RPM_PATH}
	@tar czvf ${RPM_SRIOV_DIR_NAME}.tar.gz ${RPM_SRIOV_DIR_NAME}
	@mv -vf ${RPM_SRIOV_DIR_NAME}.tar.gz ${RPM_PATH}/
	@tar czf amdgpu-exporter-sriov-$(RPM_BUILD_VERSION)-$(RPM_RELEASE_LABEL).tar.gz ${RPM_SRIOV_DIR_NAME}
	@mv amdgpu-exporter-sriov-$(RPM_BUILD_VERSION)-$(RPM_RELEASE_LABEL).tar.gz ${RPM_PATH}
	# set the version in the spec file
	@sed -i "s/RPM_BUILD_VERSION/$(RPM_BUILD_VERSION)/g" rpmbuild/amdgpu-exporter-sriov.spec
	@sed -i "s/RPM_RELEASE_LABEL/$(RPM_RELEASE_LABEL)/g" rpmbuild/amdgpu-exporter-sriov.spec
	@rpmbuild -ba --define "_topdir `pwd`" -v --buildroot `pwd`/BUILDROOT/ \
		--undefine dist rpmbuild/amdgpu-exporter-sriov.spec
	# revert the dynamic version set file
	@git checkout rpmbuild/amdgpu-exporter-sriov.spec
	# rename for internal build
	@rm -rf ${PKG_SRIOV_LUA_PATH}/plugin.proto
	@rm -rf ${PKG_SRIOV_LUA_PATH}
	@rm -rf ${PKG_SRIOV_LIB_PATH}
	@mv -v ${TOP_DIR}/RPMS/x86_64/amdgpu-exporter-sriov*.x86_64.rpm ${TOP_DIR}/bin/amdgpu-exporter-sriov-rhel9.x86_64.rpm

rpmpkg-ual-clean:
	echo "clean rpm ual package"
	@rm -rf ${RPM_PACKAGE_UAL_DIR}
	@rm -rf *.tar.gz
	@rm -rf ${RPM_PATH}/*.tar.gz
	@rm -rf ${TOP_DIR}/BUILD
	@rm -rf ${TOP_DIR}/RPMS
	@rm -rf ${TOP_DIR}/SRPMS
	@rm -rf ${TOP_DIR}/BUILDROOT
	@rm -rf ${TOP_DIR}/SOURCES

rpmpkg-ual: RPM_STAGE_DIR    = ${RPM_PACKAGE_UAL_DIR}
rpmpkg-ual: RPM_GPUAGENT_BIN = ${ASSETS_PATH}/gpuagent_ual.bin.gz
rpmpkg-ual: RPM_GPUCTL_BIN   = ${ASSETS_PATH}/gpuctl_ual
rpmpkg-ual: RPM_JQ_FILTER    = .CommonConfig.HealthService.Enable = false | del(.GPUConfig.ExtraPodLabels, .NICConfig)
rpmpkg-ual: RPM_DIR_LABEL    = ${RPM_UAL_DIR_NAME}
rpmpkg-ual: RPM_BUILD_DEFINES = --define "ual 1"
rpmpkg-ual: RPM_OUTPUT_GLOB  = amdgpuifoe-exporter*.x86_64.rpm
rpmpkg-ual: RPM_OUTPUT_FILE  = amdgpuifoe-exporter-rhel9.x86_64.rpm
rpmpkg-ual: rpmpkg-ual-clean
	@echo "build rpm ual package for $(RPM_BUILD_VERSION)-$(RPM_RELEASE_LABEL)"
	${MAKE} amdexporter
	$(rpmpkg-stage-common)
	@echo "PLATFORM=helios" >> $(RPM_STAGE_DIR)/debian/usr/local/etc/metrics/gpuagent.conf
	@sed -i 's|ExecStart=/usr/local/bin/amd-metrics-exporter$$|ExecStart=/usr/local/bin/amd-metrics-exporter -monitor-gpu=false -monitor-ifoe=true|' \
		$(RPM_STAGE_DIR)/debian/usr/lib/systemd/system/amd-metrics-exporter.service
	$(rpmpkg-finalize)

debpkg-clean:
	rm -rf ${TOP_DIR}/bin/amdgpu-exporter*.deb
	rm -rf ${PKG_LIB_PATH} ${PKG_PATH}

debpkg-sriov-clean:
	rm -rf ${TOP_DIR}/bin/amdgpu-exporter-sriov*.deb
	rm -rf ${PKG_SRIOV_PATH} ${PKG_SRIOV_LOCAL_PATH}

debpkg: debpkg-clean
	${MAKE} amdexporter
	@echo "Building debian package for $(BUILD_VER_ENV)"
	@echo "library assets build path $(PROFILER_DEB_LIBS)"
	@mkdir -p ${PKG_LIB_PATH}
	@mkdir -p ${METRICS_CONF_PATH}
	@mkdir -p ${PKG_PATH}
	@mkdir -p ${SDK_COUNTER_DEF}
	@echo "Copying prebuilt gpuagent"
ifeq ($(filter $(UAL),1 true),)
	@echo "using standard gpuagent"
	@tar -xf ${ASSETS_PATH}/gpuagent_static.bin.gz -C ${PKG_PATH}/
	@cp -vf ${ASSETS_PATH}/gpuctl.gobin ${PKG_PATH}/gpuctl
	@jq '.CommonConfig.HealthService.Enable = false | del(.GPUConfig.ExtraPodLabels, .NICConfig, .IFOEConfig)' $(CONFIG_DIR)/config.json > ${METRICS_CONF_PATH}/config.json
else
	@echo "using UAL-specific gpuagent"
	@tar -xf ${ASSETS_PATH}/gpuagent_ual.bin.gz -C ${PKG_PATH}/
	@cp -vf ${ASSETS_PATH}/gpuctl_ual ${PKG_PATH}/gpuctl
	@jq '.CommonConfig.HealthService.Enable = false | del(.GPUConfig.ExtraPodLabels, .NICConfig)' $(CONFIG_DIR)/config.json > ${METRICS_CONF_PATH}/config.json
endif
	@echo "Copy prebuilt libraries"
	@cp -rvf ${GPUAGENT_LIBS}/ ${PKG_LIB_PATH}
	@if [ ! -d $(PROFILER_DEB_LIBS) ]; then \
		echo "profiler dependent assets not built, run target libcopy-assets-${UBUNTU_LIBDIR}";\
		exit 1;\
	fi
	@echo "Copying techsupport tool"
	@cp -vaf ${TOP_DIR}/tools/techsupport/metrics-exporter-ts.sh ${PKG_PATH}/
	@chmod +x ${PKG_PATH}/metrics-exporter-ts.sh
	@echo "Copying profiler dependent libraries form ${PROFILER_DEB_LIBS}"
	@cp -vaf $(PROFILER_DEB_LIBS)/rocprofilerdeplib/lib* ${PKG_LIB_PATH}/lib/
	ls -lart ${PKG_LIB_PATH}/lib
	@echo "Copying rocprofiler client library and binary"
	@cp -vf ${ROCPROFILER_ASSETS}/librocpclient* ${PKG_LIB_PATH}/lib/
	@cp -vf ${ROCPROFILER_ASSETS}/rocpctl ${PKG_PATH}/rocpctl
	@cp -vf ${ROCPROFLER_SDK_ASSETS}/* ${SDK_COUNTER_DEF}/
	@cat ${METRICS_CONF_PATH}/config.json
	# list all the files
	@ls -lart ${PKG_LIB_PATH}/lib
	#copy and strip files
	@chmod +x ${PKG_PATH}/gpuagent
	@ls -alsh ${PKG_PATH}/gpuagent
	@chmod +x ${PKG_PATH}/rocpctl
	@ls -alsh ${PKG_PATH}/rocpctl
	#strip prebuilt binaries
	@strip ${PKG_PATH}/gpuagent
	@strip ${PKG_PATH}/rocpctl
	@ls -alsh ${PKG_PATH}/gpuagent
	@ls -alsh ${PKG_PATH}/rocpctl
	@cd ${PKG_PATH} && strip ${PKG_PATH}/gpuagent
	@cp -vf ${LUA_PROTO} ${PKG_LUA_PATH}/plugin.proto
	@cp -vf $(CURDIR)/bin/amd-metrics-exporter ${PKG_PATH}/
	@strip ${PKG_PATH}/amd-metrics-exporter
	@cp -vf $(CURDIR)/bin/metricsclient ${PKG_PATH}/
	@cp -vf $(CURDIR)/bin/amdgpuhealth ${PKG_PATH}/
	@cd ${TOP_DIR}
	@sed -i "s/BUILD_VER_ENV/$(BUILD_VER_ENV)/g" $(DEBIAN_CONTROL)
	@dpkg-deb -Zxz --build debian ${TOP_DIR}/bin
	#remove copied files
	@rm -rf ${PKG_LIB_PATH}
	@rm -rf ${METRICS_CONF_DIR}
	@rm -rf ${PKG_LUA_PATH}/plugin.proto
	# revert the dynamic version set file
	@git checkout $(DEBIAN_CONTROL)
	# rename for internal build
ifeq ($(filter $(UAL),1 true),)
	@mv -vf ${TOP_DIR}/bin/amdgpu-exporter_*~${UBUNTU_VERSION_NUMBER}_amd64.deb ${TOP_DIR}/bin/amdgpu-exporter_${UBUNTU_VERSION_NUMBER}_amd64.deb
else
	@mv -vf ${TOP_DIR}/bin/amdgpuifoe-exporter_*~${UBUNTU_VERSION_NUMBER}_amd64.deb ${TOP_DIR}/bin/amdgpuifoe-exporter_${UBUNTU_VERSION_NUMBER}_amd64.deb
endif

debpkg-ual:
	@echo "Modifying systemd service file for UAL mode"
	@sed -i 's|ExecStart=/usr/local/bin/amd-metrics-exporter$$|ExecStart=/usr/local/bin/amd-metrics-exporter -monitor-ifoe=true|' ${TOP_DIR}/debian/usr/lib/systemd/system/amd-metrics-exporter.service
	@echo "Modifying package name for UAL mode"
	@sed -i 's|^Package: amdgpu-exporter$$|Package: amdgpuifoe-exporter|' ${TOP_DIR}/debian/DEBIAN/control
	@echo "Setting PLATFORM=helios in gpuagent.conf"
	@echo "PLATFORM=helios" >> ${LIB_CONF_PATH}
	@$(MAKE) debpkg UAL=true
	@echo "Reverting systemd service file modifications"
	@git checkout ${TOP_DIR}/debian/usr/lib/systemd/system/amd-metrics-exporter.service
	@echo "Reverting gpuagent.conf modifications"
	@git checkout ${LIB_CONF_PATH}

debpkg-sriov: debpkg-sriov-clean
	${MAKE} amdexporter
	@echo "Building sriov debian for $(BUILD_VER_ENV)"
	@mkdir -p ${PKG_SRIOV_LIB_PATH}
	@mkdir -p ${METRICS_SRIOV_CONF_PATH}
	@mkdir -p ${PKG_SRIOV_PATH}
	@mkdir -p ${PKG_SRIOV_LUA_PATH}
	@echo "Copying prebuilt gpuagent"
	@tar -xf ${ASSETS_PATH}/gpuagent_sriov_static.bin.gz -C ${PKG_SRIOV_PATH}/
	@echo "Copy prebuilt libraries"
	@cp -rvf ${GPUAGENT_SRIOV_LIBS}/ ${PKG_SRIOV_LIB_PATH}
	# gpuagent-sriov has DT_NEEDED libamdsmi.so (the gim lib's soname); provide that filename so the loader resolves it from LD_LIBRARY_PATH
	@ln -sf libgim_amd_smi.so ${PKG_SRIOV_LIB_PATH}/lib/libamdsmi.so
	@cp -rvf  ${PKG_LUA_PATH}/ ${PKG_SRIOV_LUA_PATH}/../
	@cp -vf ${LIB_CONF_PATH} ${PKG_SRIOV_LUA_PATH}/../
	@echo "Copying techsupport tool"
	@cp -vaf ${TOP_DIR}/tools/techsupport/metrics-exporter-ts.sh ${PKG_SRIOV_PATH}/
	@chmod +x ${PKG_SRIOV_PATH}/metrics-exporter-ts.sh
	ls -lart ${PKG_SRIOV_LIB_PATH}/lib
	#copy default config
	@jq '.CommonConfig.HealthService.Enable = false | del(.GPUConfig.ExtraPodLabels, .GPUConfig.Fields, .GPUConfig.ProfilerMetrics, .NICConfig, .IFOEConfig)' $(CONFIG_DIR)/config.json > ${METRICS_SRIOV_CONF_PATH}/config.json
	@cat ${METRICS_SRIOV_CONF_PATH}/config.json
	# list all the files
	@ls -lart ${PKG_SRIOV_LIB_PATH}/lib
	#copy and strip files
	@chmod +x ${PKG_SRIOV_PATH}/gpuagent
	@ls -alsh ${PKG_SRIOV_PATH}/gpuagent
	#strip prebuilt binaries
	@strip ${PKG_SRIOV_PATH}/gpuagent
	@mv -vf ${PKG_SRIOV_PATH}/gpuagent ${PKG_SRIOV_PATH}/gpuagent-sriov
	@ls -alsh ${PKG_SRIOV_PATH}/gpuagent-sriov
	@cd ${PKG_SRIOV_PATH} && strip ${PKG_SRIOV_PATH}/gpuagent-sriov
	@cp -vf ${LUA_PROTO} ${PKG_SRIOV_LUA_PATH}/plugin.proto
	@cp -vf ${ASSETS_PATH}/gpuctl.gobin ${PKG_SRIOV_PATH}/gpuctl
	@cp -vf $(CURDIR)/bin/amd-metrics-exporter ${PKG_SRIOV_PATH}/amd-metrics-exporter-sriov
	@strip ${PKG_SRIOV_PATH}/amd-metrics-exporter-sriov
	@cp -vf $(CURDIR)/bin/metricsclient ${PKG_SRIOV_PATH}/
	@cp -vf $(CURDIR)/bin/amdgpuhealth ${PKG_SRIOV_PATH}/
	@cd ${TOP_DIR}
	@sed -i "s/BUILD_VER_ENV/$(BUILD_VER_ENV)/g" $(DEBIAN_SRIOV_CONTROL)
	@dpkg-deb -Zxz --build debian-sriov ${TOP_DIR}/bin
	#remove copied files
	@rm -rf ${PKG_SRIOV_PATH}
	@rm -rf ${PKG_SRIOV_LIB_PATH}
	@rm -rf ${METRICS_SRIOV_CONF_DIR}
	@rm -rf ${PKG_SRIOV_LUA_PATH}
	# revert the dynamic version set file
	@git checkout $(DEBIAN_SRIOV_CONTROL)
	# rename for internal build
	@mv -vf ${TOP_DIR}/bin/amdgpu-exporter-sriov_*~${UBUNTU_VERSION_NUMBER}_amd64.deb ${TOP_DIR}/bin/amdgpu-exporter-sriov_${UBUNTU_VERSION_NUMBER}_amd64.deb

nic-debpkg: nic-debpkg-clean
	${MAKE} amdexporter
	@echo "Building debian package for $(BUILD_VER_ENV)"

	# Ensure directories exist
	@mkdir -p $(NIC_METRICS_CONF_PATH)
	@mkdir -p $(NIC_PKG_PATH)

	# Copy default config and remove unwanted fields
	@jq 'del(.NICConfig.ExtraPodLabels, .NICConfig.HealthCheckConfig) | .CommonConfig.HealthService.Enable = false' \
		$(CONFIG_DIR)/config-nic.json > $(NIC_METRICS_CONF_PATH)/config-nic.json
	@echo "Generated NIC config:"
	@cat $(NIC_METRICS_CONF_PATH)/config-nic.json

	# Copy exporter binary
	@cp -vf $(CURDIR)/bin/amd-metrics-exporter $(NIC_PKG_PATH)/amd-nic-metrics-exporter
	@strip $(NIC_PKG_PATH)/amd-nic-metrics-exporter

	@echo "Copying techsupport tool"
	@cp -vaf ${TOP_DIR}/tools/techsupport/amd-nic-metrics-exporter-ts.sh ${NIC_PKG_PATH}/
	@chmod +x ${NIC_PKG_PATH}/amd-nic-metrics-exporter-ts.sh

	# Build debian package
	@cd $(TOP_DIR) && \
		sed -i "s/BUILD_VER_ENV/$(DEBIAN_VERSION)/g" $(NIC_DEBIAN_CONTROL) && \
		dpkg-deb -Zxz --build nic-debian bin

	# Clean up copied files
	@rm -rf $(NIC_METRICS_CONF_PATH)
	@rm -rf $(NIC_PKG_PATH)

	# Revert dynamic version change in control file
	@git checkout $(NIC_DEBIAN_CONTROL)

	# copy the builds for jammy and nobel
	@cp -vf $(TOP_DIR)/bin/amdnic-exporter_$(DEBIAN_VERSION)_amd64.deb \
		$(TOP_DIR)/bin/amdnic-exporter_22.04_amd64.deb
	@cp -vf $(TOP_DIR)/bin/amdnic-exporter_$(DEBIAN_VERSION)_amd64.deb \
		$(TOP_DIR)/bin/amdnic-exporter_24.04_amd64.deb
	@rm $(TOP_DIR)/bin/amdnic-exporter_$(DEBIAN_VERSION)_amd64.deb

nic-debpkg-clean:
	rm -rf ${TOP_DIR}/bin/amdnic-exporter*.deb
